# Copia este fichero como .env y rellena los valores.
# El .env NUNCA se sube al repositorio ni se copia fuera del PC.
# Ver docs/03-arquitectura.md, sección "Sobre guardar credenciales en .env".

# Cuenta de Gmail desde la que salen los correos.
# GMAIL_APP_PASSWORD es una CONTRASEÑA DE APLICACIÓN de 16 caracteres
# (requiere verificación en dos pasos activada en la cuenta de Google),
# nunca la contraseña de la cuenta. Se puede revocar en cualquier momento.
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=

# Cuenta de servicio de Google para leer las respuestas de los formularios.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Solo si se usa un proveedor de IA en la nube en lugar de Ollama local.
API_KEY_IA=
