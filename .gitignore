# Datos reales y copias de seguridad: nunca al repositorio
*.xlsx
*.xlsx.tmp
backups/
~$*

# Secretos y configuración local: solo se versionan los .ejemplo
.env
*.env
!.env.ejemplo
config.toml
credentials*.json
secretos/

# Salidas generadas
salidas/
*.pdf

# Ficheros de marca: sí se versionan
!assets/marca/**

# Registros de la aplicación
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.spec
